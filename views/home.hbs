<div class="text-center mb-5">
  <h1 class="fw-bold display-5 text-primary">{{mensaje}}</h1>
  <p class="text-muted">¡Qué bueno verte por acá, {{user.username}} 🐾!</p>
</div>

<div class="row g-4">
  <div class="col-md-4">
    <div class="card shadow-sm h-100">
      <div class="card-body text-center">
        <h5 class="card-title">Productos</h5>
        <p class="card-text">Explorá nuestra tienda de artículos para mascotas.</p>
        <a href="#" class="btn btn-outline-primary">Ver productos</a>
      </div>
    </div>
  </div>

  <div class="col-md-4">
    <div class="card shadow-sm h-100">
      <div class="card-body text-center">
        <h5 class="card-title">Mi carrito</h5>
        <p class="card-text">Revisá los artículos que agregaste y gestioná tu compra.</p>
        <a href="#" class="btn btn-outline-success">Ir al carrito</a>
      </div>
    </div>
  </div>

  <div class="col-md-4">
    <div class="card shadow-sm h-100">
      <div class="card-body text-center">
        <h5 class="card-title">Perfil</h5>
        <p class="card-text">Administrá tu cuenta y datos personales.</p>
        <a href="#" class="btn btn-outline-dark">Editar perfil</a>
      </div>
    </div>
  </div>
</div>
