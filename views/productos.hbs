<div class="container my-5">
  <h2 class="fw-bold mb-4 text-center text-primary">Listado de Productos</h2>

  <div class="row g-4">
    {{#each productos}}
      <div class="col-sm-6 col-md-4 col-lg-3">
        <div class="card h-100 shadow-sm border-0">
          <img src="{{imagen}}" class="card-img-top" alt="{{nombre}}" onerror="this.src='/img/no-image.png'">
          <div class="card-body d-flex flex-column justify-content-between">
            <div>
              <h5 class="card-title">{{nombre}}</h5>
              <p class="text-muted mb-1">{{Categoria.nombre}}</p>
              <p class="fw-bold">$ {{precio}}</p>
              <p class="text-secondary small">Stock: {{stock}}</p>
            </div>
            <a href="/carrito/agregar/{{id}}" class="btn btn-sm btn-success mt-2">
              <i class="bi bi-cart-plus"></i> Agregar al carrito
            </a>
          </div>
        </div>
      </div>
    {{/each}}
  </div>
</div>
