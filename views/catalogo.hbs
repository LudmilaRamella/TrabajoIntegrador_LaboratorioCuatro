<div class="container my-4">
  <h2 class="mb-4 text-center">Catálogo de Productos</h2>

  <div class="row g-4">
    {{#each productos}}
      <div class="col-sm-6 col-md-4 col-lg-3">
        <div class="card h-100 shadow-sm border-0">
          <img src="{{this.imagen}}" class="card-img-top" alt="{{this.nombre}}" onerror="this.src='/img/no-image.png'">
          <div class="card-body d-flex flex-column justify-content-between">
            <div>
              <h5 class="card-title">{{this.nombre}}</h5>
              <p class="text-muted mb-1">{{this.Categorium.nombre}}</p>
              <p class="fw-bold mb-1">$ {{this.precio}}</p>
              <p class="text-secondary small">Stock: {{this.stock}}</p>
            </div>

            <form action="/carrito/agregar" method="POST" class="mt-2 d-flex align-items-center gap-2">
              <input type="hidden" name="producto_id" value="{{this.id}}">
              <input type="number" name="cantidad" value="1" min="1" max="{{this.stock}}" class="form-control w-25 text-center">
              <button class="btn btn-sm btn-success flex-grow-1">
                <i class="bi bi-cart-plus"></i> Agregar
              </button>
            </form>
          </div>
        </div>
      </div>
    {{/each}}
  </div>
</div>
