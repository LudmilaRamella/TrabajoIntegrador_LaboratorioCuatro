<div class="container my-5">
  <h2 class="fw-bold mb-4 text-center text-primary">Categorías de Productos</h2>

  <!-- Formulario de alta -->
  <form action="/categorias" method="POST" class="d-flex justify-content-center mb-4 gap-2">
    <input type="text" name="nombre" class="form-control w-50" placeholder="Nueva categoría..." required>
    <button type="submit" class="btn btn-success">Agregar</button>
  </form>

  <!-- Listado -->
  {{#if categorias.length}}
    <table class="table table-hover align-middle text-center">
      <thead class="table-light">
        <tr>
          <th>ID</th>
          <th>Nombre</th>
        </tr>
      </thead>
      <tbody>
        {{#each categorias}}
          <tr>
            <td>{{id}}</td>
            <td>{{nombre}}</td>
          </tr>
        {{/each}}
      </tbody>
    </table>
  {{else}}
    <p class="text-center text-muted mt-3">No hay categorías registradas todavía.</p>
  {{/if}}
</div>
